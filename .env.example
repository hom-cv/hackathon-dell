MONGO_ROOT_USER=blackbox_admin
MONGO_ROOT_PASSWORD=replace-with-a-generated-password
MONGO_APP_USER=blackbox_app
MONGO_APP_PASSWORD=replace-with-another-generated-password
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=shop
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
# Set to the Docker bridge address used by the policy-constrained NemoClaw sandbox.
# AGENT_HTTP_HOST=172.18.0.1
# AGENT_HTTP_PORT=8001
CORS_ORIGINS=
DEMO_RUN_ID=local
DEPLOYMENT_ID=inventory-local
GIT_SHA=unknown
DETECTION_INTERVAL_SECONDS=2

# Host-side NemoClaw incident worker. The worker uses the application's HTTP API.
BLACKBOX_API_URL=http://127.0.0.1:8000
NEMOCLAW_SANDBOX_NAME=blackbox-agent
NEMOCLAW_GATEWAY_PORT=8990
BLACKBOX_AGENT_ID=main
BLACKBOX_AGENT_TIMEOUT=180
